{
  "name": "code_quality_audit",
  "description": "Cross-repository code quality assessment workflow",
  "schedule": "weekly",
  "steps": [
    {
      "name": "initialize",
      "tool": "get_system_status",
      "params": {}
    },
    {
      "name": "analyze",
      "tool": "analyze_repository",
      "params": {
        "depth": "full"
      }
    },
    {
      "name": "process_results",
      "tool": "handle_complex_query",
      "params": {
        "query": "Process results for Cross-repository code quality assessment workflow"
      }
    },
    {
      "name": "create_report",
      "tool": "create_issue",
      "params": {
        "type": "report"
      }
    }
  ],
  "error_handling": {
    "on_failure": "notify_and_retry",
    "max_retries": 3
  }
}