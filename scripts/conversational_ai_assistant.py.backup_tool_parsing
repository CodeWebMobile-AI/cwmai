@dataclass
class ConversationTurn:
    """Represents a single turn in the conversation."""
    timestamp: datetime
    user_input: str
    assistant_response: str
    actions_taken: List[Dict[str, Any]] = field(default_factory=list)
    context_updates: Dict[str, Any] = field(default_factory=dict)


@dataclass
class ConversationMemory:
    """Long-term memory for the assistant."""
    user_preferences: Dict[str, Any] = field(default_factory=dict)
    project_context: Dict[str, Any] = field(default_factory=dict)
    common_tasks: List[str] = field(default_factory=list)
    interaction_style: str = "friendly_professional"
    learned_patterns: Dict[str, int] = field(default_factory=dict)


class ResponseStyle(Enum):
    """Different response styles the assistant can use."""
    FRIENDLY_PROFESSIONAL = "friendly_professional"
    CONCISE = "concise"
    DETAILED = "detailed"
    TECHNICAL = "technical"
    CASUAL = "casual"


class ResetType(Enum):
    """Different types of system resets."""
    FULL = "full"  # Clear everything
    SELECTIVE = "selective"  # Preserve AI cache and/or knowledge base
    EMERGENCY = "emergency"  # When system is in bad state
    LOGS_ONLY = "logs_only"  # Clear only log files
    STATE_ONLY = "state_only"  # Clear only state files
    CACHE_ONLY = "cache_only"  # Clear only cache files


class ConversationalAIAssistant:
    """A Claude-like conversational AI assistant for CWMAI."""

    # SECURITY: Strict allowlist for system commands
    ALLOWED_SYSTEM_COMMANDS = [
        'ls -l',
        'pwd',
        'echo',
        'df -h',
        'date',
        'uptime',
        'ls',
        'ls -la',
        'whoami',
        'hostname'
    ]

    def __init__(self, style: ResponseStyle = ResponseStyle.FRIENDLY_PROFESSIONAL):
        """Initialize the conversational assistant.

        Args:
            style: The response style to use
        """
        self.logger = logging.getLogger(__name__)
        self.style = style

        # Core components
        self.ai_brain = IntelligentAIBrain(enable_round_robin=False)
        self.nli = NaturalLanguageInterface()
        self.http_client = HTTPAIClient(enable_round_robin=False)
        self.context_collector = DynamicContextCollector()
        self.workflow_orchestrator = WorkflowOrchestrator()
        self.state_manager = StateManager()  # Add state manager
        self.pattern_analyzer = ConversationPatternAnalyzer()  # Add pattern analyzer
        self.context_enhancer = get_tool_context_enhancer()  # Add context enhancer
        self.discovery_flow = ToolDiscoveryFlow()  # Add discovery flow manager

        # Initialize execution engine after tool system is ready
        self.execution_engine = None

        # Conversation state
        self.conversation_history: List[ConversationTurn] = []
        self.current_context: Dict[str, Any] = {
            'current_project': None,
            'current_task': None,
            'last_command': None,
            'pending_confirmations': {},
            'conversation_topic': None
        }

        # Memory
        self.memory = ConversationMemory()
        self.memory_file = Path.home() / ".cwmai" / "conversation_memory.json"
        self._load_memory()

        # Conversation templates
        self.templates = self._load_conversation_templates()

        # Continuous AI system control
        self.continuous_ai_process = None
        self.continuous_ai_script = Path(__file__).parent.parent / "run_continuous_ai.py"

        # Complete context mode - no need for caching
        self._tools_initialized = False

    def _load_memory(self):
        """Load conversation memory from disk."""
        try:
            if self.memory_file.exists():
                with open(self.memory_file, 'r') as f:
                    data = json.load(f)
                    self.memory.user_preferences = data.get('user_preferences', {})
                    self.memory.project_context = data.get('project_context', {})
                    self.memory.common_tasks = data.get('common_tasks', [])
                    self.memory.learned_patterns = data.get('learned_patterns', {})

                    # Load conversation history
                    history_data = data.get('conversation_history', [])
                    for turn_data in history_data[-20:]:  # Keep last 20 turns
                        try:
                            turn = ConversationTurn(
                                timestamp=datetime.fromisoformat(turn_data['timestamp']),
                                user_input=turn_data['user_input'],
                                assistant_response=turn_data['assistant_response'],
                                actions_taken=turn_data.get('actions_taken', []),
                                context_updates=turn_data.get('context_updates', {})
                            )
                            self.conversation_history.append(turn)
                        except:
                            pass  # Skip invalid entries
        except Exception as e:
            self.logger.debug(f"Could not load memory: {e}")

    def _save_memory(self):
        """Save conversation memory to disk."""
        try:
            self.memory_file.parent.mkdir(exist_ok=True)

            # Prepare conversation history for serialization
            history_data = []
            for turn in self.conversation_history[-20:]:  # Keep last 20 turns
                history_data.append({
                    'timestamp': turn.timestamp.isoformat(),
                    'user_input': turn.user_input,
                    'assistant_response': turn.assistant_response,
                    'actions_taken': turn.actions_taken,
                    'context_updates': turn.context_updates
                })

            with open(self.memory_file, 'w') as f:
                json.dump({
                    'user_preferences': self.memory.user_preferences,
                    'project_context': self.memory.project_context,
                    'common_tasks': self.memory.common_tasks[-20:],  # Keep last 20
                    'learned_patterns': self.memory.learned_patterns,
                    'conversation_history': history_data
                }, f, indent=2)
        except Exception as e:
            self.logger.debug(f"Could not save memory: {e}")

    def _load_conversation_templates(self) -> Dict[str, List[str]]:
        """Load conversation response templates."""
        return {
            'greetings': [
                "Hi! I'm your CWMAI assistant. How can I help you today?",
                "Hello! Ready to help you manage your projects. What would you like to work on?",
                "Hey there! I'm here to help with your development tasks. What's on your mind?"
            ],
            'confirmations': [
                "Got it! Let me {} for you.",
                "Sure thing! I'll {} right away.",
                "Absolutely! Working on {} now."
            ],
            'clarifications': [
                "I want to make sure I understand correctly. Did you mean {}?",
                "Just to clarify, you'd like me to {}?",
                "Let me confirm - you want to {}?"
            ],
            'thinking': [
                "Let me check that for you...",
                "Looking into this...",
                "Give me a moment to find that information..."
            ],
            'success': [
                "✓ Done! {}",
                "✓ Successfully {}",
                "✓ All set! I've {}"
            ],
            'error_gentle': [
                "I ran into a small issue: {}. Would you like me to try a different approach?",
                "Hmm, there was a problem: {}. Let me suggest an alternative.",
                "I couldn't complete that because: {}. Here's what we can do instead:"
            ]
        }

    async def initialize(self):
        """Initialize the assistant and its components."""
        log_system_message("Initializing conversational AI assistant...")
        await self.nli.initialize()
        await self.workflow_orchestrator.initialize()

        # Initialize tool execution engine
        try:
            from scripts.tool_calling_system import ToolCallingSystem
            tool_system = ToolCallingSystem()
            self.execution_engine = ToolExecutionEngine(
                ai_brain=self.ai_brain,
                tool_system=tool_system,
                discovery_flow=self.discovery_flow
            )
            log_system_message("Tool execution engine initialized")
        except Exception as e:
            log_system_message(f"Failed to initialize execution engine: {e}", "WARNING")

        # Quality monitoring disabled - was causing hangs
        # try:
        #     from scripts.quality_improvement_daemon import start_quality_monitoring
        #     await start_quality_monitoring()
        #     log_system_message("Quality monitoring started")
        # except Exception as e:
        #     log_system_message(f"Quality monitoring failed to start: {e}", "WARNING")

        log_system_message("Assistant ready for conversation")
        log_user_message("Assistant initialized and ready!")

    async def handle_conversation(self, user_input: str) -> str:
        """Handle a conversational turn with the user using AI with full context.

        # Add console logging for debugging
        print(f"\n[DEBUG] handle_conversation called with: {user_input}")

        Args:
            user_input: The user's input

        Returns:
            The assistant's response
        """
        # Update conversation context
        self._update_context(user_input)

        # ALWAYS use AI with full context - no hardcoded patterns
        response = await self._handle_with_intelligent_context(user_input)

        # Record the turn
        turn = ConversationTurn(
            timestamp=datetime.now(timezone.utc),
            user_input=user_input,
            assistant_response=response,
            actions_taken=self.current_context.get('last_actions', []),
            context_updates=self.current_context.copy()
        )
        self.conversation_history.append(turn)

        # Learn from the interaction
        self._learn_from_interaction(user_input, response)

        # Save memory periodically
        if len(self.conversation_history) % 10 == 0:
            self._save_memory()

        return response

    async def _handle_with_intelligent_context(self, user_input: str) -> str:
        """Handle user input using complete context approach.

        Provides AI with comprehensive context using Gemini's large token window.
        """
        log_system_message(f"Processing user input: {user_input[:100]}...")

        # Check if this is a continuation of a tool discovery flow
        if hasattr(self, '_tool_discovery_context'):
            return await self._continue_tool_discovery_flow(user_input)

        # Otherwise, start fresh with complete context
        print(f"[DEBUG] Calling _handle_with_complete_context")
        result = await self._handle_with_complete_context(user_input)
        print(f"[DEBUG] Result from _handle_with_complete_context: {result[:100] if result else 'None'}...")
        return result

    async def _handle_with_complete_context(self, user_input: str) -> str:
        """Handle input with COMPLETE context using Gemini's 1M token window."""
        print(f"[DEBUG] Processing with complete context: {user_input[:100]}...")

        # Gather COMPLETE system context
        dynamic_context = await self._gather_complete_context(user_input)

        # Format the complete context for AI
        formatted_context = self.context_collector.format_context_for_ai(dynamic_context)

        # Get all available tools
        essential_tools = self._get_essential_tools_for_request(user_input)

        # Get MCP tools too
        mcp_tools = []
        try:
            mcp_tools = self.mcp_hub.list_available_tools()
        except:
            pass

        # Build comprehensive tool list - include ALL tools
        tool_info = []
        for tool in essential_tools:  # Include ALL tools, not just 50
            name = tool.get('name', 'unknown')
            desc = tool.get('description', 'No description')
            params = tool.get('parameters', {})
            tool_info.append(f"- {name}: {desc}")
            if params:
                # Handle different parameter formats
                param_parts = []
                if isinstance(params, dict):
                    for k, v in params.items():
                        if isinstance(v, dict):
                            # v is a parameter definition dict
                            required = v.get('required', False)
                            param_parts.append(f"{k}({'required' if required else 'optional'})")
                        else:
                            # v is probably a type string or other format
                            param_parts.append(f"{k}(type: {v})")
                elif isinstance(params, list):
                    # params is a list of parameter names
                    param_parts = [str(p) for p in params]
                else:
                    # params is something else, just convert to string
                    param_parts = [str(params)]

                if param_parts:
                    param_list = ', '.join(param_parts)
                    tool_info.append(f"  Parameters: {param_list}")

        # Add MCP tools
        if mcp_tools:
            tool_info.append("\n=== MCP Tools ===")
            tool_info.append("- brave_search:search - Web search using Brave Search API")
            tool_info.append("- github:* - GitHub operations (issues, PRs, etc)")
            tool_info.append("- filesystem:* - File system operations")
            tool_info.append("- memory:* - Context storage and retrieval")

        # Include FULL conversation history (we have 1M tokens!)
        history_context = ""
        if self.conversation_history:
            history_context = "\n=== FULL CONVERSATION HISTORY ===\n"
            for i, turn in enumerate(self.conversation_history):
                history_context += f"\n[Turn {i+1} - {turn.timestamp.strftime('%H:%M:%S')}]\n"
                history_context += f"User: {turn.user_input}\n"
                history_context += f"Assistant: {turn.assistant_response}\n"
                if turn.actions_taken:
                    history_context += f"Actions: {turn.actions_taken}\n"

        # Build comprehensive prompt with ALL context
        prompt = f"""=== COMPLETE SYSTEM CONTEXT ===
{formatted_context}

{history_context}

=== INTELLIGENT CODEBASE CONTEXT ===
The system has provided query-aware codebase context based on your request.
- Query Type: {dynamic_context.get('codebase', {}).get('query_type', 'general')}
- Context includes: file structure, code analysis, tool information, and more
- Usage hints: {', '.join(dynamic_context.get('codebase', {}).get('usage_hints', []))}

=== CURRENT REQUEST ===
Request: {user_input}

You are an AI assistant with COMPLETE understanding of this codebase. You have:
1. Full system context including all repositories, tasks, and workflows
2. Intelligent codebase analysis tailored to the query
3. Access to all tools to explore and discover information
4. 1 million token context window - no need to worry about space

Your goal is to provide the MOST helpful, accurate, and complete answers possible.

Available tools (ALL {len(essential_tools)} tools included):
{chr(10).join(tool_info)}

CODEBASE UNDERSTANDING:
- The intelligent context system analyzed your query and provided relevant code information
- If you need deeper analysis of specific files/functions, they're included in the context
- Reference code locations using file:line format when helpful
- The context is query-aware - it focuses on what's relevant to your question

Be extremely thorough. With 1M tokens available, provide comprehensive answers that fully address the user's needs.

When creating tools:
1. ALWAYS search the codebase first to find existing functionality
2. NEVER create placeholder implementations - tools must actually work
3. Integrate with existing modules like GitHubIssueCreator, WorkflowOrchestrator, StateManager
4. Use async/await patterns consistent with the codebase
5. Return structured responses: {{"success": bool, "result": data, "error": str}}
6. The system will enforce these rules and reject placeholder tools

IMPORTANT TOOL EXECUTION FORMAT:
- To EXECUTE a tool, use: EXECUTE_TOOL::tool_name(params)::END_TOOL
- Or use the simpler format: !execute tool_name(params)
- Examples and explanations should use regular format: tool_name(params)
- Only tools wrapped in EXECUTE_TOOL:: or !execute will actually run

Examples:
- Showing an example: "You could use count_files(directory='.')"
- Actually executing: "EXECUTE_TOOL::count_files(directory='.')::END_TOOL"
- Or executing: "!execute count_files(directory='.')"

Respond naturally and comprehensively. Use all available context to provide the best possible answer."""

        try:
            print(f"[DEBUG] About to call execute_capability...")
            response = await self.ai_brain.execute_capability('intelligent_analysis', {
                'prompt': prompt,
                'model': 'gemini'
            })
            print(f"[DEBUG] Response from execute_capability: type={type(response)}, content={response}")

            # Type check to prevent AttributeError
            if isinstance(response, dict):
                ai_response = response.get('result', '')
                print(f"[DEBUG] Extracted result from dict: {ai_response[:100] if ai_response else 'None'}...")
            else:
                print(f"[DEBUG] Unexpected response type: {type(response)}")
                ai_response = str(response)

            # Process the response to execute any mentioned tools
            print(f"[DEBUG] About to process AI response...")
            processed_response = await self._process_ai_response(ai_response, user_input)
            print(f"[DEBUG] Processed response: {processed_response[:100] if processed_response else 'None'}...")
            return processed_response

        except Exception as e:
            import traceback
            self.logger.error(f"Error in _handle_with_complete_context: {e}")
            print(f"[DEBUG] Full traceback: {traceback.format_exc()}")
            return f"Error: {str(e)}"

    async def _execute_and_continue(self, ai_response: str, original_request: str) -> str:
        """Execute tools mentioned in AI response and continue the conversation flow.

        This method handles multi-step workflows where the AI needs to:
        1. Execute a tool
        2. Analyze the results
        3. Decide on next steps
        4. Continue until the task is complete
        """
        # Check if this is a multi-step workflow
        if "STEP:" in ai_response or "Next:" in ai_response:
            # Process the current step
            processed = await self._process_ai_response(ai_response, original_request)

            # Check if we need to continue
            if "COMPLETE" not in processed and "FINAL" not in processed:
                # Ask AI what to do next based on results
                continuation_prompt = f"""Original request: {original_request}

Previous step result:
{processed}

What should we do next to complete the user's request? If the task is complete, say COMPLETE."""

                next_response = await self.ai_brain.execute_capability('intelligent_analysis', {
                    'prompt': continuation_prompt,
                    'model': 'gemini'
                })

                # Type check to prevent AttributeError
                if isinstance(next_response, dict):
                    next_step = next_response.get('result', '')
                else:
                    print(f"[DEBUG] Unexpected next_response type: {type(next_response)}")
                    next_step = str(next_response)

                # Recursively continue if not complete
                if "COMPLETE" not in next_step:
                    return await self._execute_and_continue(next_step, original_request)

            return processed
        else:
            # Single step response, just process normally
            return await self._process_ai_response(ai_response, original_request)

    def _get_essential_tools_for_request(self, user_input: str) -> List[Dict[str, Any]]:
        """Get all available tools."""
        try:
            from scripts.tool_calling_system import ToolCallingSystem
            tool_system = ToolCallingSystem()
            return tool_system.get_tools_for_ai()
        except:
            return []

    def _format_essential_tools(self, tools: List[Dict[str, Any]], style: str = "detailed") -> str:
        """Format tools for AI display in various styles.

        Args:
            tools: List of tool definitions
            style: Format style - 'detailed', 'compact', 'categorized'

        Returns:
            Formatted string representation of tools
        """
        if not tools:
            return "No tools available"

        if style == "compact":
            # Just tool names
            return ', '.join([t.get('name', 'unknown') for t in tools[:30]])

        elif style == "categorized":
            # Group tools by category
            categories = {
                'search': [],
                'analysis': [],
                'creation': [],
                'system': [],
                'repository': [],
                'other': []
            }

            for tool in tools:
                name = tool.get('name', '').lower()
                if 'search' in name or 'grep' in name or 'find' in name:
                    categories['search'].append(tool)
                elif 'analyze' in name or 'check' in name or 'test' in name:
                    categories['analysis'].append(tool)
                elif 'create' in name or 'generate' in name or 'make' in name:
                    categories['creation'].append(tool)
                elif 'system' in name or 'status' in name or 'control' in name:
                    categories['system'].append(tool)
                elif 'repository' in name or 'repo' in name or 'project' in name:
                    categories['repository'].append(tool)
                else:
                    categories['other'].append(tool)

            formatted = []
            for cat, cat_tools in categories.items():
                if cat_tools:
                    formatted.append(f"\n{cat.upper()} TOOLS:")
                    for tool in cat_tools[:5]:  # Limit per category
                        formatted.append(f"  - {tool.get('name')}: {tool.get('description', '')[:60]}...")

            return '\n'.join(formatted)

        else:  # detailed
            # Full details for most relevant tools
            formatted = []
            for tool in tools[:15]:  # Top 15 tools
                name = tool.get('name', 'unknown')
                desc = tool.get('description', 'No description')[:80]
                params = tool.get('parameters', {})
                param_list = ', '.join(params.keys()) if params else 'none'

                formatted.append(f"- {name}: {desc}\n  Parameters: {param_list}")

            return '\n'.join(formatted)


    async def _process_ai_response(self, ai_response: str, user_input: str) -> str:
        """Process AI response and execute any tool calls mentioned."""
        import re

        # Get available tools
        tools = self._get_essential_tools_for_request(user_input)
        tool_names = [t['name'] for t in tools]

        executed_tools = []

        # Pattern 1: EXECUTE_TOOL::tool_name(params)::END_TOOL
        exec_pattern = r'EXECUTE_TOOL::(\w+)\s*\((.*?)\)::END_TOOL'
        for match in re.finditer(exec_pattern, ai_response):
            tool_name = match.group(1)
            params_str = match.group(2)
            if tool_name in tool_names:
                try:
                    tool_call = f"{tool_name}({params_str})"
                    result = await self._execute_tool_call(tool_call)
                    executed_tools.append((tool_name, result))
                except Exception as e:
                    self.logger.error(f"Error executing tool {tool_name}: {e}")

        # Also support simpler !execute format
        simple_exec_pattern = r'!execute\s+(\w+)\s*\((.*?)\)'
        for match in re.finditer(simple_exec_pattern, ai_response):
            tool_name = match.group(1)
            params_str = match.group(2)
            if tool_name in tool_names:
                try:
                    tool_call = f"{tool_name}({params_str})"
                    result = await self._execute_tool_call(tool_call)
                    executed_tools.append((tool_name, result))
                except Exception as e:
                    self.logger.error(f"Error executing tool {tool_name}: {e}")

        # Pattern 3: Code blocks with tool calls (```tool_code or ``` blocks)
        # This handles various code block formats the AI might use
        code_block_patterns = [
            # Matches ```tool_code\ntool_name(params)\n```
            r'```(?:tool_code|python|code)?\s*\n\s*(\w+)\s*\((.*?)\)\s*\n\s*```',
            # Matches standalone function calls in code blocks
            r'```\s*\n\s*(\w+)\s*\((.*?)\)\s*\n\s*```',
            # Matches inline code blocks `tool_name(params)`
            r'`(\w+)\s*\((.*?)\)`'
        ]

        for pattern in code_block_patterns:
            for match in re.finditer(pattern, ai_response, re.DOTALL):
                tool_name = match.group(1)
                params_str = match.group(2)
                # Check if this is a known tool and hasn't been executed yet
                if tool_name in tool_names and not any(t[0] == tool_name and str(t[1]).count(params_str) > 0 for t in executed_tools):
                    try:
                        tool_call = f"{tool_name}({params_str})"
                        result = await self._execute_tool_call(tool_call)
                        executed_tools.append((tool_name, result))
                        self.logger.info(f"Executed tool from code block: {tool_name}")
                    except Exception as e:
                        self.logger.error(f"Error executing tool {tool_name}: {e}")

        # Pattern 4: Standalone tool names on their own line (legacy support)
        lines = ai_response.split('\n')
        for line in lines:
            line = line.strip()
            # Skip lines that are part of code blocks
            if line.startswith('```') or line.endswith('```'):
                continue
            # Check if line is just a tool name (possibly with backticks)
            cleaned_line = line.strip('`').strip()
            # Match tool_name() format
            standalone_match = re.match(r'^(\w+)\s*\(\s*\)$', cleaned_line)
            if standalone_match:
                tool_name = standalone_match.group(1)
                if tool_name in tool_names and tool_name not in [t[0] for t in executed_tools]:
                    try:
                        tool_call = f"{tool_name}()"
                        result = await self._execute_tool_call(tool_call)
                        executed_tools.append((tool_name, result))
                    except Exception as e:
                        self.logger.error(f"Error executing tool {tool_name}: {e}")

        # If we executed any tools, have AI interpret the results
        if executed_tools:
            # Build a prompt for the AI to interpret the results
            interpretation_prompt = f"The user asked: {user_input}\n\n"
            interpretation_prompt += "I executed the following tools and got these results:\n\n"

            for tool_name, result in executed_tools:
                interpretation_prompt += f"Tool: {tool_name}\n"
                if isinstance(result, dict):
                    import json
                    interpretation_prompt += f"Result: {json.dumps(result, indent=2)}\n\n"
                else:
                    interpretation_prompt += f"Result: {str(result)}\n\n"

            interpretation_prompt += "Please provide a natural language summary of these results for the user. Be conversational and highlight the key information."

            # Get AI to interpret the results
            try:
                response = await self.ai_brain.execute_capability('intelligent_analysis', {
                    'prompt': interpretation_prompt,
                    'model': 'gemini'
                })

                # Type check to prevent AttributeError
                if isinstance(response, dict):
                    interpreted_response = response.get('result', '')
                else:
                    print(f"[DEBUG] Unexpected interpretation response type: {type(response)}")
                    interpreted_response = str(response)

                # Return the original AI response plus the interpretation
                return f"{ai_response}\n\n{interpreted_response}"

            except Exception as e:
                self.logger.error(f"Error interpreting results: {e}")
                # Fallback to showing raw results
                return f"{ai_response}\n\nTool Results: {json.dumps(executed_tools[0][1], indent=2)}"

        # Otherwise just return the AI response
        return ai_response

    async def _continue_tool_discovery_flow(self, user_input: str) -> str:
        """Continue an ongoing tool discovery flow for multi-step tool creation.

        This handles cases where creating a tool requires multiple steps:
        1. Gathering requirements
        2. Confirming specifications
        3. Implementing the tool
        4. Testing and refinement
        """
        if not hasattr(self, '_tool_discovery_context'):
            # No ongoing flow, start fresh
            return await self._handle_with_complete_context(user_input)

        context = self._tool_discovery_context
        current_step = context.get('step', 'requirements')

        if current_step == 'requirements':
            # User provided requirements, move to confirmation
            context['requirements'] = user_input
            context['step'] = 'confirmation'

            return f"""I understand you want to create a tool with these requirements:
{user_input}

Let me confirm the specifications:
- Tool name: {context.get('tool_name', 'To be determined')}
- Purpose: {context.get('purpose', 'To be determined')}
- Parameters needed: {context.get('parameters', 'To be determined')}

Is this correct? Would you like me to proceed with creating this tool?"""

        elif current_step == 'confirmation':
            if 'yes' in user_input.lower() or 'proceed' in user_input.lower():
                # Create the tool
                context['step'] = 'implementation'

                # Use the create_new_tool function
                try:
                    from scripts.tool_calling_system import ToolCallingSystem
                    tool_system = ToolCallingSystem()

                    result = await tool_system.call_tool(
                        'create_new_tool',
                        name=context.get('tool_name'),
                        description=context.get('purpose'),
                        requirements=context.get('requirements')
                    )

                    # Clear the context
                    delattr(self, '_tool_discovery_context')

                    # Type check result
                    if isinstance(result, dict):
                        if result.get('success'):
                            return f"✅ Tool created successfully! You can now use `{context.get('tool_name')}` in your commands."
                        else:
                            return f"❌ Tool creation failed: {result.get('error')}"
                    else:
                        return f"❌ Tool creation failed: Unexpected result format - {str(result)}"

                except Exception as e:
                    delattr(self, '_tool_discovery_context')
                    return f"❌ Error creating tool: {str(e)}"
            else:
                # User wants changes
                context['step'] = 'requirements'
                return "What changes would you like to make to the tool specifications?"

        # Default fallback
        return await self._handle_with_complete_context(user_input)




